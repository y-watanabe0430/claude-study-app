{
  "name": "claude-study-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "verify:dist": "node scripts/verify-dist.mjs",
    "inventory": "node scripts/inventory.mjs",
    "smoke:pwa": "node scripts/pwa-smoke.mjs",
    "serve:subpath": "node scripts/serve-subpath.mjs dist",
    "extract:sources": "node scripts/extract-sources.mjs",
    "check:translations": "node scripts/check-translations.mjs CCDV-F && node scripts/check-translations.mjs CCAO-F && node scripts/check-translations.mjs CCAR-P && node scripts/check-translations.mjs CCAR-F",
    "build:packs": "node scripts/build-packs.mjs && node scripts/write-report.mjs",
    "review:letters": "node scripts/check-letters.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
