{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/claude-study/question-pack.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "titleJa",
    "language",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "packId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "titleJa": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "ja"
    },
    "createdAt": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": [
        "id",
        "revision",
        "exam",
        "type",
        "domainJa",
        "status",
        "translationStatus",
        "ja",
        "source",
        "correctAnswer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "exam": {
          "enum": [
            "CCDV-F",
            "CCAO-F",
            "CCAR-P",
            "CCAR-F"
          ]
        },
        "type": {
          "enum": [
            "single",
            "multiple",
            "matching",
            "ordering"
          ]
        },
        "domainJa": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "needs_review"
          ]
        },
        "translationStatus": {
          "enum": [
            "original_ja",
            "translated_ja",
            "pending"
          ]
        },
        "ja": {
          "type": "object",
          "required": [
            "stem",
            "explanation"
          ],
          "properties": {
            "stem": {
              "type": "string",
              "minLength": 1
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            },
            "background": {
              "type": "string"
            },
            "scenario": {
              "type": "string"
            }
          }
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "textJa"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "textJa": {
                "type": "string",
                "minLength": 1
              },
              "explanationJa": {
                "type": "string"
              },
              "originalLabel": {
                "type": "string"
              }
            }
          }
        },
        "requiredSelections": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "object",
          "required": [
            "sourceId",
            "originalId"
          ],
          "properties": {
            "sourceId": {
              "type": "string"
            },
            "originalId": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          }
        },
        "correctAnswer": {
          "type": "object"
        },
        "matching": {
          "type": "object",
          "required": [
            "prompts",
            "candidates",
            "allowReuse"
          ],
          "properties": {
            "prompts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "candidates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "allowReuse": {
              "type": "boolean"
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "altJa",
              "placement"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^assets/"
              },
              "altJa": {
                "type": "string"
              },
              "placement": {
                "enum": [
                  "stem",
                  "explanation"
                ]
              }
            }
          }
        },
        "reviewNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shuffleChoices": {
          "type": "boolean"
        },
        "supplemental": {
          "type": "object"
        },
        "originalText": {
          "type": "object"
        },
        "duplicateGroupId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "single"
              }
            }
          },
          "then": {
            "required": [
              "choices",
              "requiredSelections"
            ],
            "properties": {
              "correctAnswer": {
                "type": "object",
                "required": [
                  "choiceIds"
                ],
                "properties": {
                  "choiceIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 1
                  }
                }
              },
              "requiredSelections": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple"
              }
            }
          },
          "then": {
            "required": [
              "choices",
              "requiredSelections"
            ],
            "properties": {
              "correctAnswer": {
                "type": "object",
                "required": [
                  "choiceIds"
                ],
                "properties": {
                  "choiceIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matching"
              }
            }
          },
          "then": {
            "required": [
              "matching"
            ],
            "properties": {
              "correctAnswer": {
                "type": "object",
                "required": [
                  "matches"
                ],
                "properties": {
                  "matches": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ordering"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ],
            "properties": {
              "correctAnswer": {
                "type": "object",
                "required": [
                  "order"
                ],
                "properties": {
                  "order": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "textJa"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "textJa": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}